    <apikit:config name="s-layer-rjaencobos-config" api="resource::d36a1128-e322-46b8-b0ff-0e2971ea1aea:s-layer-rjaencobos:1.0.0:raml:zip:s-layer-rjaencobos.raml" outboundHeadersMapName="outboundHeaders" httpStatusVarName="httpStatus" />
